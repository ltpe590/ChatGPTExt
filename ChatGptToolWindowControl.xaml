<UserControl x:Class="ChatGptVsix.ChatGptToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="350" MinHeight="300">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: status only (model/provider from Options page) -->
        <TextBlock x:Name="StatusText" Grid.Row="0" Margin="0,0,0,6"
                   FontStyle="Italic" Foreground="Gray" FontSize="11"/>

        <!-- Prompt input -->
        <TextBox x:Name="PromptBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 ToolTip="Type a prompt, or use Tools > AI: Fix Errors to auto-populate"/>

        <!-- Action buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,8">
            <Button x:Name="SendBtn"    Content="Send"    Width="80"  Click="SendBtn_Click" />
            <Button x:Name="CancelBtn"  Content="Cancel"  Width="80"  Click="CancelBtn_Click" IsEnabled="False" Margin="4,0,0,0"/>
            <Button x:Name="ClearBtn"   Content="Clear"   Width="80"  Click="ClearBtn_Click"  Margin="4,0,0,0"/>
            <Button x:Name="ApplyFixBtn" Content="✔ Apply Fix" Width="100" Click="ApplyFixBtn_Click"
                    Margin="12,0,0,0" IsEnabled="False"
                    ToolTip="Extract the ```csharp block from the response and write it back to the active file"/>
        </StackPanel>

        <!-- Response area -->
        <TextBox x:Name="ResponseBox" Grid.Row="3" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" IsReadOnly="True" FontFamily="Consolas" FontSize="12"/>

        <!-- Apply status bar -->
        <TextBlock x:Name="ApplyStatusText" Grid.Row="4" Margin="0,4,0,0"
                   FontSize="11" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
